{
  "name": "mobigo",
  "private": true,
  "version": "0.1.0",
  "description": "Mobi GO — planejamento de viagens em transporte coletivo com tempo real para o estado de Goiás",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @mobigo/api db:migrate",
    "gtfs:load": "pnpm --filter @mobigo/api gtfs:load",
    "dev:api": "pnpm --filter @mobigo/api dev",
    "dev:web": "pnpm --filter @mobigo/web dev",
    "dev:simulator": "pnpm --filter @mobigo/api simulator"
  }
}
