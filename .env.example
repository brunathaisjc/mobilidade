# Copie para .env e ajuste. Valores padrão servem para desenvolvimento local.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mobi:mobi@localhost:5432/mobilidade
REDIS_URL=redis://localhost:6379
# Obrigatório em produção (≥ 32 caracteres aleatórios): openssl rand -base64 48
JWT_SECRET=
PUBLIC_WEB_URL=http://localhost:5173
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_BUCKET=avatars
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_URL=http://localhost:9000/avatars
# OpenTripPlanner (opcional; sem ele, planejador interno de linhas diretas)
# OTP_URL=http://localhost:8081
# Geocodificador compatível com Photon (opcional; sem ele, busca só por pontos de ônibus)
# GEOCODER_URL=https://photon.exemplo.go.gov.br
MAX_WALK_METERS=800
